# BeyondTheLoop — required server environment (L4 pre-sell engine).
#
# Copy to `.env.local` and fill with REAL values to run the money/email paths
# locally. NEVER commit a filled-in env file (.gitignore ignores all .env*).
# These keys are validated LAZILY at request time (src/lib/env.ts) — the build,
# typecheck, and lint all pass WITHOUT any of them set.

# --- Loops (email list + founding sequence) -> LoopsAdapter / SubscriberRepository
LOOPS_API_KEY=

# --- Lemon Squeezy (Merchant of Record) -> LemonSqueezyAdapter / PurchaseRepository
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# The founding-price variant the checkout is created against.
LEMONSQUEEZY_VARIANT_ID=
# Secret used to verify inbound webhook signatures (HMAC-SHA256).
LEMONSQUEEZY_WEBHOOK_SECRET=

# --- Amplitude (funnel analytics) -> AmplitudeAdapter / AnalyticsClient
AMPLITUDE_API_KEY=
